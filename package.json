{
  "name": "kfbox",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-2.0-or-later",
  "packageManager": "pnpm@10.17.1",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "app": "tauri build",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "check": "scripts/guard-staged.sh && cargo fmt --all --check && pnpm -s lint && tsc --noEmit && vitest run --silent && cargo clippy --workspace --all-targets -q -- -D warnings && node scripts/test-rust.mjs",
    "test:rust": "node scripts/test-rust.mjs",
    "test": "vitest run",
    "prepare": "node scripts/install-hooks.mjs",
    "format": "prettier --write src index.html vite.config.ts eslint.config.js",
    "lint": "eslint . && prettier --check src index.html vite.config.ts eslint.config.js",
    "smoke": "node scripts/smoke-app.mjs",
    "perf": "node scripts/perf-app.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2",
    "lucide-react": "^1.68.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
